---
const reasons = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
    title: "Alineación de intereses",
    description: "No cobramos comisión por producto. Nuestro modelo está diseñado para que nuestro éxito dependa del tuyo. Recomendamos lo que creemos que es correcto para cada cliente, no lo que nos genera mayor margen.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    title: "Disciplina financiera",
    description: "Tomamos decisiones consistentes y racionales con un proceso claro, independientemente de las condiciones de mercado. El ruido del corto plazo no cambia nuestra forma de trabajar.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
    title: "Independencia y objetividad",
    description: "Somos independientes de bancos, fondos y estructuras de distribución. Nuestro asesoramiento está basado en análisis objetivo y en el mejor interés de cada cliente, sin conflictos de producto.",
  },
];
---

<section id="PorQueAmbar" class="py-20 bg-primary-dark text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>

  <div class="container-custom relative">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold">Por qué Ambar</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/70">
        En un mercado transaccional y orientado al producto, construimos relaciones basadas en tres principios que no negociamos.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {reasons.map((reason, index) => (
        <div class={`rounded-2xl p-8 border border-white/10 bg-white/5 animate-on-scroll delay-${index + 2} hover:bg-white/10 transition-all duration-300`}>
          <div class="text-signature-accent mb-5" set:html={reason.icon} />
          <h3 class="text-xl font-semibold text-white">{reason.title}</h3>
          <p class="mt-3 text-white/70 leading-relaxed">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
