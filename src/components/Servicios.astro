---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import serviceImage1 from '../assets/service-1.svg';
import serviceImage2 from '../assets/service-2.svg';
import serviceImage3 from '../assets/service-3.svg';

const services = [
  {
    title: "Asset Management",
    description: "Gestión de liquidez e inversiones corporativas",
    image: serviceImage1,
  },
  {
    title: "Capital Markets",
    description: "FX, financiamiento y estructuración financiera",
    image: serviceImage2,
  },
  {
    title: "Wealth Management",
    description: "Gestión patrimonial para individuos y familias",
    image: serviceImage3,
  },
];
---

<section ID="Servicios" class="py-20 bg-premium-neutral to-payflo-gray relative overflow-hidden">
  <!-- Subtle background pattern with parallax effect -->
  <div class="absolute inset-0 opacity-5 parallax" data-speed="0.1">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold">
        Servicios
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-gray-600">
        Acompañamos a nuestros clientes con soluciones adaptadas a sus necesidades financieras, patrimoniales y corporativas
      </p>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div  class={`bg-white rounded-2xl p-8 shadow-lg border border-premium-detail animate-on-scroll delay-${index + 2} group hover:shadow-xl transition-all duration-300 hover:-translate-y-2`}>
          <h3 class="text-2xl font-semibold transition-colors duration-300 group-hover:text-payflo-purple">{service.title}</h3>
          <p class="mt-3 text-gray-600">{service.description}</p>
          <div class="mt-6 hover-zoom rounded-lg overflow-hidden">
            <Image 
              src={service.image} 
              alt={service.title}
              class="w-full max-w-[180px] h-[140px] object-contain mx-auto rounded-lg transition-all duration-500"
              width={300}
              height={200}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
