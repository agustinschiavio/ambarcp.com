---
import { Image } from 'astro:assets';
import serviceImage1 from '../assets/service-1.svg';
import serviceImage2 from '../assets/service-2.svg';

const services = [
  {
    title: "Corporate Solutions",
    tag: "Para empresas",
    description: "Acompañamos a empresas que quieren que su capital trabaje con mayor eficiencia, previsibilidad y control.",
    bullets: [
      "Cash Management y optimización de liquidez",
      "FX — conversión y movimiento de capital",
      "Financiamiento: capital de trabajo, cauciones, ONs",
      "Coberturas y gestión de exposición financiera",
      "Optimización de fricciones operativas",
    ],
    image: serviceImage1,
  },
  {
    title: "Wealth Management",
    tag: "Para individuos y familias",
    description: "Gestionamos el capital de individuos y familias con disciplina y alineación de intereses.",
    bullets: [
      "Diagnóstico financiero y planificación patrimonial",
      "Estrategia de portafolio y asset allocation",
      "Gestión de liquidez y planificación de largo plazo",
      "Gestión de riesgo y preservación de capital",
      "Asesoramiento independiente y continuo",
    ],
    image: serviceImage2,
  },
];
---

<section id="Servicios" class="py-20 bg-premium-neutral relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 parallax" data-speed="0.1">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold">
        Servicios
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-gray-600">
        No vendemos productos aislados. Analizamos la estructura financiera de cada cliente y diseñamos soluciones alineadas con sus objetivos, liquidez y exposición al riesgo.
      </p>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((service, index) => (
        <div class={`bg-white rounded-2xl p-8 shadow-lg border border-premium-detail animate-on-scroll delay-${index + 2} group hover:shadow-xl transition-all duration-300 hover:-translate-y-2`}>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest text-signature-accent mb-4">{service.tag}</span>
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <Image 
                src={service.image} 
                alt={service.title}
                class="w-[72px] h-[72px] object-contain"
                width={72}
                height={72}
              />
            </div>
            <div>
              <h3 class="text-2xl font-semibold transition-colors duration-300 group-hover:text-signature-accent">{service.title}</h3>
              <p class="mt-2 text-gray-600">{service.description}</p>
            </div>
          </div>
          <ul class="mt-6 space-y-2">
            {service.bullets.map((bullet) => (
              <li class="flex items-start gap-2 text-gray-600">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-signature-accent flex-shrink-0"></span>
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>