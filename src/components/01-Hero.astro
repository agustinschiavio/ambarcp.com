---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-2.jpg';
---

<section class="pt-20 pb-10 md:pt-28 md:pb-12 overflow-hidden relative">
  <div class="container-custom relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-lg">
        <h1 class="animate-on-scroll delay-0 font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-tight tracking-tight">
          Vos conocés<br />tus objetivos
        </h1>
        <h2 class="animate-on-scroll delay-1 font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-tight tracking-tight mt-4">
          <span class="text-premium-neutral" style="background-color: #0E1A26; padding: 2px 10px 6px; box-decoration-break: clone; -webkit-box-decoration-break: clone;">Nosotros te ayudamos a lograrlos</span>
        </h2>
        <p class="animate-on-scroll delay-2 mt-8 text-lg text-typography/70 max-w-sm leading-relaxed">
          Asesoría financiera independiente para empresas y personas.
        </p>
        <div class="animate-on-scroll delay-3 mt-8">
          <a href="#Servicios" class="group btn text-base bg-primary-dark text-white hover:bg-primary-dark/90">
            Conocé más<span class="inline-block ml-1 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition-all duration-200">↗</span>
          </a>
        </div>
      </div>

      <div class="animate-on-scroll delay-4">
        <div class="relative hover-zoom">
          <div class="absolute -inset-0.5 bg-gradient-to-br from-signature-accent/60 to-primary-dark/60 rounded-xl blur opacity-40 transition-opacity duration-300 hover:opacity-60"></div>
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={heroImage}
              alt="Ambar Capital Partners"
              class="w-full h-auto transition-all duration-500"
              width={700}
              height={500}
            />
            <div class="absolute inset-0 bg-gradient-to-br from-signature-accent/15 via-transparent to-primary-dark/25 rounded-xl"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
