---
const steps = [
  {
    number: "01",
    title: "Disciplina",
    description: "Tomar decisiones consistentes y racionales, evitando decisiones emocionales",
  },
  {
    number: "02",
    title: "Alineación de Intereses",
    description: "Independencia para tomar decisiones objetivas, alineadas con los intereses de los inversores",
  },
];
---

<section id="Filosofia" class="py-20 bg-payflo-gray relative overflow-hidden" >
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold">Filosofía</h2>
      <p class="animate-on-scroll delay-1 mt-4 text-xl text-typography/80">
        Creemos que una buena gestión financiera depende de tomar decisiones consistentes, racionales y alineadas con cada cliente
      </p>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 relative">
      
      {steps.map((step, index) => (
        <div 
          class={`bg-premium-neutral rounded-xl p-8 shadow-lg border border-premium-detail animate-on-scroll delay-${index + 2} group hover:shadow-xl transition-all duration-300 hover:-translate-y-2`}
        >
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-signature-accent/10 text-signature-accent font-semibold transition-all duration-300 group-hover:bg-signature-accent group-hover:text-white group-hover:scale-110">
            {step.number}
          </div>
          <h3 class="mt-6 text-xl font-semibold transition-colors duration-300 group-hover:text-signature-accent">{step.title}</h3>
          <p class="mt-3 text-typography/80">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
