---
const steps = [
  {
    number: "01",
    title: "Disciplina",
    description: "Tomamos decisiones consistentes y racionales, con un proceso claro que se mantiene independientemente de las condiciones de mercado.",
  },
  {
    number: "02",
    title: "Alineación de Intereses",
    description: "Buscamos estructuras donde el éxito sea compartido y los incentivos sean claros y transparentes para todos.",
  },
  {
    number: "03",
    title: "Independencia",
    description: "Brindamos asesoramiento basado en análisis objetivo y en el mejor interés de cada cliente, con criterio propio y visión de largo plazo.",
  },
];
---

<section id="Filosofia" class="py-20 pt-20 pb-10 bg-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  
  <div class="container-custom relative">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold">Filosofía</h2>
      <p class="mt-6 text-lg leading-relaxed text-gray-600">
        Creemos que una buena gestión financiera depende de tomar decisiones consistentes, racionales y alineadas con cada cliente
      </p>
    </div>
    
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((step, index) => (
        <div 
          class={`bg-white rounded-xl p-8 shadow-lg border border-gray-100 animate-on-scroll delay-${index + 2} group hover:shadow-xl transition-all duration-300 hover:-translate-y-2`}
        >
          <div class="inline-flex items-center rounded-2xl bg-signature-accent px-5 py-3 text-2xl font-bold text-white shadow-md">
            {step.title}
          </div>
          <p class="mt-6 text-lg leading-relaxed text-gray-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>