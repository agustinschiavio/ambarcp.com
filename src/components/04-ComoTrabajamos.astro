---
const steps = [
  {
    number: "01",
    title: "Diagnóstico",
    description: "Empezamos por entender dónde estás parado: tu situación, tus objetivos y lo que no podés perder de vista.",
  },
  {
    number: "02",
    title: "Estrategia",
    description: "Diseñamos un plan a medida. Sin soluciones genéricas — solo lo que tiene sentido para vos.",
  },
  {
    number: "03",
    title: "Ejecución y seguimiento",
    description: "Ejecutamos y seguimos de cerca. Si algo cambia, nos adaptamos — y siempre te mantenemos informado.",
  },
];
---

<section id="ComoTrabajamos" class="py-32 bg-white relative overflow-hidden">
  <div class="container-custom relative">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight">Cómo trabajamos</h2>
      <p class="mt-4 text-lg leading-relaxed text-gray-600">
        Un proceso claro que no cambia con el mercado.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connector line (desktop only) -->
      <div class="hidden md:block absolute top-10 left-1/6 right-1/6 h-px bg-signature-accent/30" style="left: 16.66%; right: 16.66%;"></div>

      {steps.map((step, index) => (
        <div class="relative bg-white rounded-xl p-8 border border-premium-detail hover:border-signature-accent/30 transition-all duration-500">
          <div class="flex items-center gap-4 mb-5">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary-dark text-white text-sm font-bold flex-shrink-0">
              {step.number}
            </span>
            <h3 class="font-heading text-2xl font-semibold tracking-tight">{step.title}</h3>
          </div>
          <p class="text-gray-600 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
