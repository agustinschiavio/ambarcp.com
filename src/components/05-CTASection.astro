---
---

<section id="Contacto" class="py-32 bg-primary-dark text-white relative overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-signature-accent/40"></div>

  <div class="container-custom relative">
    <div class="max-w-2xl mx-auto text-center animate-on-scroll">
      <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight whitespace-nowrap">
        Reservá tu lugar
      </h2>
      <p class="mt-4 text-lg opacity-90">
        Una conversación honesta. Sin presión, sin productos para vender.
      </p>

      <!-- Primary CTA: Calendar -->
      <div class="mt-8 flex flex-row justify-center gap-4">
        <a
          href="https://calendar.app.google/yBvMKcWRFNcZLaH28"
          target="_blank"
          style="display:inline-flex; align-items:center; gap:8px; white-space:nowrap; padding:16px 32px; border-radius:8px; font-size:1.125rem; font-weight:500; background:white; color:#A46B3C; transition:all 0.3s;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" style="flex-shrink:0;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <span>Reservá tu lugar</span>
        </a>
        <a
          href="https://wa.me/5491173725618"
          target="_blank"
          style="display:inline-flex; align-items:center; gap:8px; white-space:nowrap; padding:16px 32px; border-radius:8px; font-size:1.125rem; font-weight:500; border:1px solid rgba(255,255,255,0.4); color:white; transition:all 0.3s;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" style="flex-shrink:0;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Divider -->
      <div class="mt-10 flex items-center gap-4">
        <div class="flex-1 h-px bg-white/20"></div>
        <span class="text-white/50 text-sm">o dejanos tu consulta</span>
        <div class="flex-1 h-px bg-white/20"></div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="mt-8 space-y-4 text-left"
      >
        <input type="hidden" name="access_key" value="a5b2cf8c-f78f-491c-bba0-9a5c5aeadd28" />
        <input type="hidden" name="subject" value="Nueva consulta desde ambarcp.com" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input
            type="text"
            name="name"
            placeholder="Nombre"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:border-white/60 transition"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:border-white/60 transition"
          />
        </div>
        <textarea
          name="message"
          placeholder="¿En qué te podemos ayudar?"
          rows="4"
          class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:border-white/60 transition resize-none"
        ></textarea>
        <button
          type="submit"
          class="w-full btn bg-white/15 border border-white/30 hover:bg-white/25 text-white transition-all duration-300 hover:scale-[1.02]"
        >
          Enviar consulta
        </button>

        <!-- Success message -->
        <div id="form-success" class="hidden text-center py-4">
          <p class="text-white font-medium">¡Mensaje enviado! Te contactamos a la brevedad.</p>
        </div>
      </form>

      <script>
        const form = document.getElementById('contact-form') as HTMLFormElement;
        const success = document.getElementById('form-success');

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: data,
          });
          if (res.ok) {
            form.reset();
            form.querySelectorAll('input, textarea, button').forEach(el => (el as HTMLElement).style.display = 'none');
            success?.classList.remove('hidden');
          }
        });
      </script>
    </div>
  </div>
</section>
